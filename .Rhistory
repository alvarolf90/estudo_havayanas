# Instale os pacotes caso não os tenha: install.packages("tidyverse")
library(tidyverse)
## 1. Definir os aeroportos de interesse
aeroportos_alvo <- c("SBCF", "SBKP", "SBSP", "SBRJ", "SBCT", "SBEG", "SBFL",
"SBTE", "SBCG", "SBVT", "SBGR", "SBGL", "SBBH", "SBMO",
"SBMQ", "SBPV", "SBCY", "SBAR", "SBBE", "SBBV", "SBGO",
"SBJP", "SBPJ", "SBRB", "SBRF", "SBSL", "SBBR", "SBSV", "SBPA", "SBSG", "SBFZ")
## 2. Ler e processar os Dados Abertos
# Lista todos os arquivos CSV dentro das subpastas de 2023, 2024 e 2025
arquivos_abertos <- list.files(path = "Dados_abertos",
pattern = "\\.csv$",
recursive = TRUE,
full.names = TRUE)
df_abertos <- map_df(arquivos_abertos, read_csv2, skip = 1, col_types = cols(DT_TOQUE = col_date(), NR_VOO_NUMERO = col_number(), DT_PREVISTO = col_date())
)
# Agrupar dados abertos (Filtrando apenas para Partidas para bater com "Decolagens")
resumo_abertos <- df_abertos %>%
filter(NR_AEROPORTO_REFERENCIA %in% aeroportos_alvo) %>%
# Nota: Verifique como a string exata aparece no seu CSV ("Partida", "PARTIDA", etc.)
filter(str_detect(toupper(NR_MOVIMENTO_TIPO), "P")) %>%
group_by(ANO, Aeroporto = NR_AEROPORTO_REFERENCIA) %>%
summarise(
Voos_Abertos = n(), # Cada linha é um voo
Passageiros_Abertos = sum(QT_PAX_LOCAL, na.rm = TRUE) +
sum(QT_PAX_CONEXAO_DOMESTICO, na.rm = TRUE) +
sum(QT_PAX_CONEXAO_INTERNACIONAL, na.rm = TRUE),
.groups = "drop"
)
df_abertos %>%
filter(NR_AEROPORTO_REFERENCIA %in% aeroportos_alvo)
## 2. Ler e processar os Dados Abertos
# Lista todos os arquivos CSV dentro das subpastas de 2023, 2024 e 2025
