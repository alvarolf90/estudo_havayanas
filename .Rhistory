aeroportos_alvo <- c("SBCF", "SBKP", "SBSP", "SBRJ", "SBCT", "SBEG", "SBFL",
"SBTE", "SBCG", "SBVT", "SBGR", "SBGL", "SBBH", "SBMO",
"SBMQ", "SBPV", "SBCY", "SBAR", "SBBE", "SBBV", "SBGO",
"SBJP", "SBPJ", "SBRB", "SBRF", "SBSL", "SBBR", "SBSV", "SBPA", "SBSG", "SBFZ")
## 2. Ler e processar os Dados Abertos
# Lista todos os arquivos CSV dentro das subpastas de 2023, 2024 e 2025
arquivos_abertos <- list.files(path = "Dados_abertos",
pattern = "\\.csv$",
recursive = TRUE,
full.names = TRUE)
df_abertos <- map_df(arquivos_abertos, read_csv2, skip = 1, col_types = cols(DT_TOQUE = col_date(), NR_VOO_NUMERO = col_number(), DT_PREVISTO = col_date())
)
# Agrupar dados abertos por MOVIMENTAÇÃO TOTAL do aeroporto.
# Cada linha aqui já é um único movimento (chegada OU partida) do aeroporto
# em NR_AEROPORTO_REFERENCIA (NR_MOVIMENTO_TIPO = "P" ou "D"). Antes o script
# filtrava só "P" (Partida), contando metade do movimento -- igual ao problema
# que achamos nos Dados Estatísticos. Agora somamos os dois tipos.
resumo_abertos <- df_abertos %>%
filter(NR_AEROPORTO_REFERENCIA %in% aeroportos_alvo) %>%
group_by(ANO, Aeroporto = NR_AEROPORTO_REFERENCIA) %>%
summarise(
Voos_Abertos = n(), # Cada linha é um movimento (partida ou chegada)
Passageiros_Abertos = sum(QT_PAX_LOCAL, na.rm = TRUE) +
sum(QT_PAX_CONEXAO_DOMESTICO, na.rm = TRUE) +
sum(QT_PAX_CONEXAO_INTERNACIONAL, na.rm = TRUE),
Carga_Abertos = sum(QT_CARGA, na.rm = TRUE),
.groups = "drop"
)
## 3. Ler e processar os Dados Estatísticos
arquivos_estatisticos <- list.files(path = "Dados_estatisticos",
pattern = "\\.csv$",
full.names = TRUE)
df_estatisticos <- map_df(arquivos_estatisticos, read_csv2, locale = locale(encoding = "latin1"), show_col_types = FALSE)
# IMPORTANTE: cada linha é um voo com uma ORIGEM e um DESTINO. A base final
# usada nos modelos (Base_Final_DEA.csv) conta a MOVIMENTAÇÃO TOTAL do
# aeroporto -- partidas + chegadas --, não só partidas. Filtrar só por
# "AEROPORTO DE ORIGEM" (como estava antes) conta só metade do movimento.
# Por isso somamos separadamente origem e destino e depois juntamos.
estatisticos_origem <- df_estatisticos %>%
filter(`AEROPORTO DE ORIGEM (SIGLA)` %in% aeroportos_alvo) %>%
group_by(ANO, Aeroporto = `AEROPORTO DE ORIGEM (SIGLA)`) %>%
summarise(
Voos_Est = sum(DECOLAGENS, na.rm = TRUE),
Passageiros_Est = sum(`PASSAGEIROS PAGOS`, na.rm = TRUE) +
sum(`PASSAGEIROS GRÁTIS`, na.rm = TRUE),
Carga_Est = sum(`CARGA PAGA (KG)`, na.rm = TRUE) +
sum(`CARGA GRÁTIS (KG)`, na.rm = TRUE),
.groups = "drop"
)
estatisticos_destino <- df_estatisticos %>%
filter(`AEROPORTO DE DESTINO (SIGLA)` %in% aeroportos_alvo) %>%
group_by(ANO, Aeroporto = `AEROPORTO DE DESTINO (SIGLA)`) %>%
summarise(
Voos_Est = sum(DECOLAGENS, na.rm = TRUE),
Passageiros_Est = sum(`PASSAGEIROS PAGOS`, na.rm = TRUE) +
sum(`PASSAGEIROS GRÁTIS`, na.rm = TRUE),
Carga_Est = sum(`CARGA PAGA (KG)`, na.rm = TRUE) +
sum(`CARGA GRÁTIS (KG)`, na.rm = TRUE),
.groups = "drop"
)
resumo_estatisticos <- bind_rows(estatisticos_origem, estatisticos_destino) %>%
group_by(ANO, Aeroporto) %>%
summarise(
Voos_Est = sum(Voos_Est, na.rm = TRUE),
Passageiros_Est = sum(Passageiros_Est, na.rm = TRUE),
Carga_Est = sum(Carga_Est, na.rm = TRUE),
.groups = "drop"
)
## 4. Comparar as duas bases
comparacao <- full_join(resumo_abertos, resumo_estatisticos, by = c("ANO", "Aeroporto")) %>%
mutate(
Diff_Voos = Voos_Abertos - Voos_Est,
Diff_Passageiros = Passageiros_Abertos - Passageiros_Est,
Iguais = (Diff_Voos == 0 & Diff_Passageiros == 0)
)
# Exibir os casos onde há divergência
divergencias <- comparacao %>% filter(Iguais == FALSE | is.na(Iguais))
print("Divergências encontradas (se houver):")
View(divergencias)
## 5. Calcular estatísticas anuais para os aeroportos selecionados, uma
## tabela para cada base (Dados Estatísticos e Dados Abertos), as duas já
## com a correção de somar origem + destino / partida + chegada.
estatisticas_alvo <- resumo_estatisticos %>%
filter(Aeroporto %in% aeroportos_alvo) %>%
arrange(Aeroporto, ANO) %>%
rename(Total_Voos = Voos_Est, Total_Passageiros = Passageiros_Est, Total_Carga_KG = Carga_Est)
abertos_alvo <- resumo_abertos %>%
filter(Aeroporto %in% aeroportos_alvo) %>%
arrange(Aeroporto, ANO) %>%
rename(Total_Voos = Voos_Abertos, Total_Passageiros = Passageiros_Abertos, Total_Carga_KG = Carga_Abertos)
print("Estatísticas anuais (Dados Estatísticos) dos aeroportos selecionados:")
print(estatisticas_alvo)
print("Estatísticas anuais (Dados Abertos) dos aeroportos selecionados:")
print(abertos_alvo)
## 6. Exportar as duas tabelas processadas (etapa que faltava no script
## original -- era por isso que a Tabela_Processados_Aeroportos_Alvo.csv
## tinha que ser exportada manualmente e ninguém tinha certeza de como
## ela foi gerada)
write_csv(estatisticas_alvo, "Tabela_Processados_Aeroportos_Alvo_DadosEstatisticos.csv")
write_csv(abertos_alvo, "Tabela_Processados_Aeroportos_Alvo_DadosAbertos.csv")
## 6. Exportar as duas tabelas processadas (etapa que faltava no script
## original -- era por isso que a Tabela_Processados_Aeroportos_Alvo.csv
## tinha que ser exportada manualmente e ninguém tinha certeza de como
## ela foi gerada)
write_csv(estatisticas_alvo, "Tabela_Processados_Aeroportos_Alvo_DadosEstatisticos.csv")
write_csv(abertos_alvo, "Tabela_Processados_Aeroportos_Alvo_DadosAbertos.csv")
