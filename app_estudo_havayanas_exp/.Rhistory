# GABARITO DA PROVA PRÁTICA - QUESTÃO 4
# ==============================================================================
library(C50)
library(e1071)
library(gmodels)
# 1. Importação e Preparação
dados_spotify <- read.csv("spotify_artist_streaming_2020_2025.csv", stringsAsFactors = TRUE)
# ==============================================================================
# GABARITO DA PROVA PRÁTICA - QUESTÃO 4
# ==============================================================================
library(C50)
library(e1071)
library(gmodels)
# 1. Importação e Preparação
dados_spotify <- read.csv("spotify_artist_streaming_2020_2025.csv", stringsAsFactors = TRUE)
View(dados_spotify)
# Selecionando apenas as colunas exigidas na prova
colunas_prova <- c("danceability", "energy", "loudness", "tempo",
"duration_minutes", "genre", "explicit", "popularity_category")
df_prova <- dados_spotify[, colunas_prova]
# Garantindo que as categóricas sejam fatores
df_prova$genre <- as.factor(df_prova$genre)
df_prova$explicit <- as.factor(df_prova$explicit)
df_prova$popularity_category <- as.factor(df_prova$popularity_category)
# Divisão 80/20 com semente 42
set.seed(42)
tamanho_treino <- floor(0.75 * nrow(df_prova))
indices_treino <- sample(seq_len(nrow(df_prova)), size = tamanho_treino)
treino <- df_prova[indices_treino, ]
teste  <- df_prova[-indices_treino, ]
# ==============================================================================
# MODELO 1: ÁRVORE C5.0
# ==============================================================================
# Treinamento
modelo_c50 <- C5.0(popularity_category ~ ., data = treino)
# PREPARE-SE PARA A QUESTÃO 4A:
# O summary abaixo mostrará a árvore em texto. A primeira linha indentada é a Regra Raiz.
cat("\n=== ESTRUTURA DA ÁRVORE C5.0 (QUESTÃO 4A) ===\n")
summary(modelo_c50)
# Previsão
pred_c50 <- predict(modelo_c50, teste)
# ==============================================================================
# MODELO 2: NAIVE BAYES
# ==============================================================================
# Treinamento com Laplace
modelo_nb <- naiveBayes(popularity_category ~ ., data = treino, laplace = 1)
# Previsão
pred_nb <- predict(modelo_nb, teste)
# ==============================================================================
# AVALIAÇÃO (QUESTÃO 4B)
# ==============================================================================
cat("\n=== MATRIZ DE CONFUSÃO: C5.0 ===\n")
CrossTable(pred_c50, teste$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE,
dnn = c('Previsto', 'Real'))
cat("\n=== MATRIZ DE CONFUSÃO: NAIVE BAYES ===\n")
CrossTable(pred_nb, teste$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE,
dnn = c('Previsto', 'Real'))
View(treino)
# ==============================================================================
# GABARITO DA PROVA PRÁTICA - QUESTÃO 4 (COM DISCRETIZAÇÃO EM QUARTIS)
# ==============================================================================
library(C50)
library(e1071)
library(gmodels)
# 1. Importação e Preparação Base
dados_spotify <- read.csv("spotify_artist_streaming_2020_2025.csv", stringsAsFactors = TRUE)
colunas_prova <- c("danceability", "energy", "loudness", "tempo",
"duration_minutes", "genre", "explicit", "popularity_category")
df_prova <- dados_spotify[, colunas_prova]
df_prova$genre <- as.factor(df_prova$genre)
df_prova$explicit <- as.factor(df_prova$explicit)
df_prova$popularity_category <- as.factor(df_prova$popularity_category)
set.seed(42)
tamanho_treino <- floor(0.80 * nrow(df_prova))
indices_treino <- sample(seq_len(nrow(df_prova)), size = tamanho_treino)
treino <- df_prova[indices_treino, ]
teste  <- df_prova[-indices_treino, ]
# ==============================================================================
# MODELO 1: ÁRVORE C5.0 (Usa os dados contínuos normalmente)
# ==============================================================================
modelo_c50 <- C5.0(popularity_category ~ ., data = treino)
pred_c50 <- predict(modelo_c50, teste)
cat("\n=== ESTRUTURA DA ÁRVORE C5.0 (QUESTÃO 4A) ===\n")
summary(modelo_c50)
# ==============================================================================
# PREPARAÇÃO PARA O MODELO 2: NAIVE BAYES COM QUARTIS
# ==============================================================================
# Criamos cópias para não estragar a base original
treino_nb <- treino
teste_nb <- teste
# Identificamos as variáveis numéricas acústicas
vars_continuas <- c("danceability", "energy", "loudness", "tempo", "duration_minutes")
# Loop para transformar cada variável contínua em 4 categorias (Quartis)
for(v in vars_continuas){
# Calcula os pontos de corte (quartis) usando APENAS os dados de treino
pontos_corte <- quantile(treino_nb[[v]], probs = seq(0, 1, 0.25), na.rm = TRUE)
# Aplica o cut() no Treino
treino_nb[[v]] <- cut(treino_nb[[v]],
breaks = unique(pontos_corte),
include.lowest = TRUE,
labels = c("Q1", "Q2", "Q3", "Q4")[1:(length(unique(pontos_corte))-1)])
# Aplica o cut() no Teste (usando os cortes do treino para não vazar dados!)
teste_nb[[v]] <- cut(teste_nb[[v]],
breaks = unique(pontos_corte),
include.lowest = TRUE,
labels = c("Q1", "Q2", "Q3", "Q4")[1:(length(unique(pontos_corte))-1)])
}
# ==============================================================================
# MODELO 2: NAIVE BAYES (Agora usando dados 100% categóricos)
# ==============================================================================
modelo_nb <- naiveBayes(popularity_category ~ ., data = treino_nb, laplace = 1)
pred_nb <- predict(modelo_nb, teste_nb)
# ==============================================================================
# AVALIAÇÃO FINAL
# ==============================================================================
cat("\n=== MATRIZ DE CONFUSÃO: C5.0 ===\n")
CrossTable(pred_c50, teste$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE, dnn = c('Previsto', 'Real'))
cat("\n=== MATRIZ DE CONFUSÃO: NAIVE BAYES (DISCRETIZADO) ===\n")
CrossTable(pred_nb, teste_nb$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE, dnn = c('Previsto', 'Real'))
# ==============================================================================
# GABARITO DA PROVA PRÁTICA - QUESTÃO 4 (COM DISCRETIZAÇÃO EM QUARTIS)
# ==============================================================================
library(C50)
library(e1071)
library(gmodels)
# 1. Importação e Preparação Base
dados_spotify <- read.csv("spotify_artist_streaming_2020_2025.csv", stringsAsFactors = TRUE)
colunas_prova <- c("danceability", "energy", "loudness", "tempo",
"duration_minutes", "genre", "explicit", "popularity_category")
df_prova <- dados_spotify[, colunas_prova]
df_prova$genre <- as.factor(df_prova$genre)
df_prova$explicit <- as.factor(df_prova$explicit)
df_prova$popularity_category <- as.factor(df_prova$popularity_category)
set.seed(42)
tamanho_treino <- floor(0.75 * nrow(df_prova))
indices_treino <- sample(seq_len(nrow(df_prova)), size = tamanho_treino)
treino <- df_prova[indices_treino, ]
teste  <- df_prova[-indices_treino, ]
# ==============================================================================
# MODELO 1: ÁRVORE C5.0 (Usa os dados contínuos normalmente)
# ==============================================================================
modelo_c50 <- C5.0(popularity_category ~ ., data = treino)
pred_c50 <- predict(modelo_c50, teste)
cat("\n=== ESTRUTURA DA ÁRVORE C5.0 (QUESTÃO 4A) ===\n")
summary(modelo_c50)
# ==============================================================================
# PREPARAÇÃO PARA O MODELO 2: NAIVE BAYES COM QUARTIS
# ==============================================================================
# Criamos cópias para não estragar a base original
treino_nb <- treino
teste_nb <- teste
# Identificamos as variáveis numéricas acústicas
vars_continuas <- c("danceability", "energy", "loudness", "tempo", "duration_minutes")
# Loop para transformar cada variável contínua em 4 categorias (Quartis)
for(v in vars_continuas){
# Calcula os pontos de corte (quartis) usando APENAS os dados de treino
pontos_corte <- quantile(treino_nb[[v]], probs = seq(0, 1, 0.25), na.rm = TRUE)
# Aplica o cut() no Treino
treino_nb[[v]] <- cut(treino_nb[[v]],
breaks = unique(pontos_corte),
include.lowest = TRUE,
labels = c("Q1", "Q2", "Q3", "Q4")[1:(length(unique(pontos_corte))-1)])
# Aplica o cut() no Teste (usando os cortes do treino para não vazar dados!)
teste_nb[[v]] <- cut(teste_nb[[v]],
breaks = unique(pontos_corte),
include.lowest = TRUE,
labels = c("Q1", "Q2", "Q3", "Q4")[1:(length(unique(pontos_corte))-1)])
}
# ==============================================================================
# MODELO 2: NAIVE BAYES (Agora usando dados 100% categóricos)
# ==============================================================================
modelo_nb <- naiveBayes(popularity_category ~ ., data = treino_nb, laplace = 1)
pred_nb <- predict(modelo_nb, teste_nb)
# ==============================================================================
# AVALIAÇÃO FINAL
# ==============================================================================
cat("\n=== MATRIZ DE CONFUSÃO: C5.0 ===\n")
CrossTable(pred_c50, teste$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE, dnn = c('Previsto', 'Real'))
cat("\n=== MATRIZ DE CONFUSÃO: NAIVE BAYES (DISCRETIZADO) ===\n")
CrossTable(pred_nb, teste_nb$popularity_category,
prop.chisq = FALSE, prop.c = FALSE, prop.r = FALSE, dnn = c('Previsto', 'Real'))
# ==============================================================================
# FUNÇÃO PARA EXTRAIR FALSOS POSITIVOS E NEGATIVOS POR CLASSE
# ==============================================================================
calcular_erros_classe <- function(previsto, real) {
# Gera a matriz de confusão crua (linhas = Previsto, colunas = Real)
matriz <- table(Previsto = previsto, Real = real)
# Cria um data frame vazio para preencher
classes <- colnames(matriz)
df_erros <- data.frame(
Categoria = classes,
Falsos_Positivos = numeric(length(classes)),
Falsos_Negativos = numeric(length(classes))
)
# Calcula FP e FN iterando sobre cada classe da matriz
for(i in seq_along(classes)) {
# Falso Positivo (FP): Soma da linha i menos o acerto (diagonal principal)
df_erros$Falsos_Positivos[i] <- sum(matriz[i, ]) - matriz[i, i]
# Falso Negativo (FN): Soma da coluna i menos o acerto (diagonal principal)
df_erros$Falsos_Negativos[i] <- sum(matriz[, i]) - matriz[i, i]
}
return(df_erros)
}
# Aplicando para o modelo C5.0
cat("\n=== ERROS ABSOLUTOS: MODELO C5.0 ===\n")
erros_c50 <- calcular_erros_classe(previsto = pred_c50, real = teste$popularity_category)
print(erros_c50)
# Aplicando para o Naive Bayes
cat("\n=== ERROS ABSOLUTOS: NAIVE BAYES ===\n")
erros_nb <- calcular_erros_classe(previsto = pred_nb, real = teste$popularity_category) # ou teste_nb se usou os quartis
print(erros_nb)
# ==============================================================================
# FUNÇÃO AVANÇADA: ACERTOS, ERROS E PERCENTUAIS POR CLASSE
# ==============================================================================
calcular_erros_classe <- function(previsto, real) {
# Gera a matriz de confusão crua
matriz <- table(Previsto = previsto, Real = real)
classes <- colnames(matriz)
# Cria o data frame vazio com as novas colunas
df_erros <- data.frame(
Categoria = classes,
Acertos = numeric(length(classes)),
Falsos_Positivos = numeric(length(classes)),
Perc_FP = numeric(length(classes)),
Falsos_Negativos = numeric(length(classes)),
Perc_FN = numeric(length(classes))
)
for(i in seq_along(classes)) {
# 1. Isolando os valores absolutos
acertos <- matriz[i, i]
fp <- sum(matriz[i, ]) - acertos
fn <- sum(matriz[, i]) - acertos
total_previsto <- sum(matriz[i, ]) # Linha inteira
total_real <- sum(matriz[, i])     # Coluna inteira
# 2. Calculando os percentuais (com ifelse para evitar divisão por zero)
# % FP = (Falsos Positivos / Total de vezes que o modelo chutou essa classe)
perc_fp <- ifelse(total_previsto > 0, (fp / total_previsto) * 100, 0)
# % FN = (Falsos Negativos / Total de itens que realmente são dessa classe)
perc_fn <- ifelse(total_real > 0, (fn / total_real) * 100, 0)
# 3. Preenchendo o Data Frame
df_erros$Acertos[i] <- acertos
df_erros$Falsos_Positivos[i] <- fp
df_erros$Perc_FP[i] <- paste0(round(perc_fp, 1), "%")
df_erros$Falsos_Negativos[i] <- fn
df_erros$Perc_FN[i] <- paste0(round(perc_fn, 1), "%")
}
return(df_erros)
}
cat("\n=== PERFORMANCE DETALHADA: ÁRVORE C5.0 ===\n")
performance_c50 <- calcular_erros_classe(previsto = pred_c50, real = teste$popularity_category)
print(performance_c50)
cat("\n=== PERFORMANCE DETALHADA: NAIVE BAYES ===\n")
performance_nb <- calcular_erros_classe(previsto = pred_nb, real = teste$popularity_category)
print(performance_nb)
# ==============================================================================
# FUNÇÃO AVANÇADA: ACERTOS, ERROS E PERCENTUAIS POR CLASSE
# ==============================================================================
calcular_erros_classe <- function(previsto, real) {
# Gera a matriz de confusão crua
matriz <- table(Previsto = previsto, Real = real)
classes <- colnames(matriz)
# Cria o data frame vazio com as novas colunas
df_erros <- data.frame(
Categoria = classes,
# Visão da Realidade (O que a classe de fato é)
Total_Real = numeric(length(classes)),
Acertos = numeric(length(classes)),
Perc_Acerto = character(length(classes)),
Falsos_Negativos = numeric(length(classes)),
Perc_FN = character(length(classes)),
# Visão da Previsão (O que o modelo achou que era)
Total_Previsto = numeric(length(classes)),
Falsos_Positivos = numeric(length(classes)),
Perc_FP = character(length(classes))
)
for(i in seq_along(classes)) {
# 1. Isolando os valores absolutos
acertos <- matriz[i, i]
total_real <- sum(matriz[, i])      # Coluna inteira
total_previsto <- sum(matriz[i, ])  # Linha inteira
fn <- total_real - acertos
fp <- total_previsto - acertos
# 2. Calculando os percentuais com suas respectivas bases
# Taxa de Acerto e Falso Negativo usam o Total Real como base
perc_acerto <- ifelse(total_real > 0, (acertos / total_real) * 100, 0)
perc_fn <- ifelse(total_real > 0, (fn / total_real) * 100, 0)
# Taxa de Falso Positivo usa o Total Previsto como base
perc_fp <- ifelse(total_previsto > 0, (fp / total_previsto) * 100, 0)
# 3. Preenchendo o Data Frame
df_erros$Total_Real[i] <- total_real
df_erros$Acertos[i] <- acertos
df_erros$Perc_Acerto[i] <- paste0(round(perc_acerto, 1), "%")
df_erros$Falsos_Negativos[i] <- fn
df_erros$Perc_FN[i] <- paste0(round(perc_fn, 1), "%")
df_erros$Total_Previsto[i] <- total_previsto
df_erros$Falsos_Positivos[i] <- fp
df_erros$Perc_FP[i] <- paste0(round(perc_fp, 1), "%")
}
return(df_erros)
}
cat("\n=== PERFORMANCE DETALHADA: ÁRVORE C5.0 ===\n")
performance_c50 <- calcular_erros_classe(previsto = pred_c50, real = teste$popularity_category)
print(performance_c50)
