# Script do Professor - Geração da base "fresadora_preditiva.csv"
set.seed(42)
n <- 1500
# Variáveis preditoras simuladas
temperatura_ar <- rnorm(n, mean = 298, sd = 2) # em Kelvin
temperatura_processo <- temperatura_ar + rnorm(n, mean = 10, sd = 1)
rotacao_rpm <- rnorm(n, mean = 1500, sd = 200)
torque_nm <- rnorm(n, mean = 40, sd = 10)
desgaste_ferramenta <- runif(n, 0, 250) # em minutos de uso
tipo_material <- sample(c("Aco", "Aluminio", "Titânio"), n, replace = TRUE, prob = c(0.5, 0.3, 0.2))
# Lógica de falha oculta (Mistura de regras para CART e Naive Bayes tentarem capturar)
prob_falha <- 0.02 +
ifelse(desgaste_ferramenta > 200 & torque_nm > 50, 0.4, 0) +
ifelse(temperatura_processo - temperatura_ar > 12, 0.25, 0) +
ifelse(rotacao_rpm < 1200, 0.1, 0)
falha_maquina <- ifelse(runif(n) < prob_falha, "Sim", "Nao")
df_prova <- data.frame(
tipo_material = as.factor(tipo_material),
temperatura_ar = round(temperatura_ar, 1),
temperatura_processo = round(temperatura_processo, 1),
rotacao_rpm = round(rotacao_rpm, 0),
torque_nm = round(torque_nm, 1),
desgaste_ferramenta = round(desgaste_ferramenta, 0),
falha_maquina = as.factor(falha_maquina)
)
write.csv(df_prova, "fresadora_preditiva.csv", row.names = FALSE)
